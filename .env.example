# Optional. Set these in Vercel → Project → Settings → Environment Variables.

# Optional Acartia API token (from your account at https://acartia.io). The
# current-sightings feed is public, so this is only needed if Acartia requires it.
ACARTIA_TOKEN=

# Map style. Defaults to OpenFreeMap's "liberty" style (free, no key needed).
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
